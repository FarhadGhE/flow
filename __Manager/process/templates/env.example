# Machine-local values for this manage repo. Copy this file to .env (never committed) and fill it in.
# Use absolute paths, with forward slashes on Windows too.

# Your handle (letters and digits). It names your direct-turn folders.
FLOW_DEVELOPER=

# Where each involved directory is on this machine: one line per directory in the root AGENTS.md.
{{KEY}}=/absolute/path/to/{{FOLDER}}

# Toolchains that are not on PATH (optional)
#TOOL_{{NAME}}=
